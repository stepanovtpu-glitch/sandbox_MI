# Frontend
VITE_API_BASE=http://127.0.0.1:8000

# Backend
PYTHONUNBUFFERED=1

# Яндекс Мессенджер: worker запускается отдельно через Compose profile `messenger`.
# GASMETER_YM_TOKEN= # OAuth токен бота, хранить только в секретном .env
# GASMETER_YM_USER_MAP={} # JSON: {"логин_в_Яндекс":"логин_GasMeter"}; при совпадении логинов не обязателен
# GASMETER_LLM_BASE_URL=
# GASMETER_LLM_PROVIDER=auto
# GASMETER_LLM_MODEL=
# GASMETER_LLM_API_KEY=

# ФГИС «Аршин»: worker периодической сверки (проверяет только экземпляры,
# добавленные в разделе «Поверки в Аршине»; интервал цикла worker, сек).
GASMETER_ARSHIN_WORKER_INTERVAL_SECONDS=60
